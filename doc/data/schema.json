{
  "name": "PToJ 로컬 데이터 모델",
  "description": "서버/DB 없이 브라우저 localStorage에 저장하는 데이터 구조. 키 하나(ptoj:data)에 전체를 JSON으로 저장한다.",
  "storage": {
    "key": "ptoj:data",
    "meta_key": "ptoj:meta",
    "note": "meta는 마지막 백업 시각, 안내 배너 닫은 시각 등 UI 상태. data는 아래 구조 그대로."
  },
  "conventions": {
    "id": "문자열 (crypto.randomUUID)",
    "datetime": "ISO 8601 UTC 문자열",
    "date": "YYYY-MM-DD",
    "time": "HH:mm (24시간)",
    "naming": "camelCase",
    "delete_policy": "완전 삭제. 보드 삭제 시 카드/참석자도 함께 삭제"
  },
  "root": {
    "version": "number. 스키마 버전 (현재 1). 불러올 때 마이그레이션/거부 판단",
    "boards": "Board[]"
  },
  "Board": {
    "id": "string",
    "name": "string, 1~30자",
    "createdAt": "datetime",
    "updatedAt": "datetime",
    "cards": "Card[]"
  },
  "Card": {
    "id": "string",
    "title": "string, 1~50자",
    "content": "string, 0~500자",
    "date": "date",
    "startTime": "time",
    "endTime": "time | null (있으면 startTime보다 늦어야 함)",
    "placeName": "string | null",
    "address": "string | null",
    "isCompleted": "boolean",
    "completedAt": "datetime | null (isCompleted=false이면 null)",
    "attendanceEnabled": "boolean",
    "attendees": "Attendee[] (attendanceEnabled=false여도 보관)",
    "createdAt": "datetime (같은 시간대 좌/우 배치 기준: 먼저 작성이 좌측)",
    "updatedAt": "datetime"
  },
  "Attendee": {
    "id": "string",
    "name": "string, 1~20자",
    "status": "'yes' | 'no' | 'maybe'"
  },
  "share_payload": {
    "description": "공유 링크/JSON 내보내기 형식. 보드 1개를 담는다.",
    "format": { "app": "ptoj", "version": 1, "board": "Board" },
    "link": "https://sanmihyang.github.io/PToJ/#/import?d=<base64url(deflate(JSON))>",
    "import_rule": "새 보드로 추가하고 보드/카드/참석자 ID를 모두 새로 발급. 완료 상태는 그대로 유지(이미지처럼 스냅샷 전달)"
  },
  "backup_payload": {
    "format": { "app": "ptoj", "version": 1, "backup": true, "boards": "Board[]" },
    "restore_modes": ["replace", "merge"]
  }
}
